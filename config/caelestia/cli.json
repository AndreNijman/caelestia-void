{
    "toggles": {
        "claude": {
            "claude-desktop": {
                "enable": true,
                "match": [{ "class": "claude" }],
                "command": ["claude-desktop"],
                "move": true
            }
        },
        "communication": {
            "equibop": {
                "enable": true,
                "match": [{ "class": "equibop" }, { "class": "vesktop" }],
                "command": ["equibop"],
                "move": true
            }
        },
        "music": {
            "spotify": {
                "enable": true,
                "match": [
                    { "class": "Spotify" },
                    { "class": "com.spotify.Client" },
                    { "initialTitle": "Spotify" },
                    { "initialTitle": "Spotify Free" }
                ],
                "command": ["flatpak", "run", "com.spotify.Client"],
                "move": true
            }
        }
    }
}
